{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pismo Accounts Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List client webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pismo.io/webhooks/v1/webhooks"
          },
          "docs": "List client webhooks"
        },
        {
          "info": {
            "name": "Register client webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pismo.io/webhooks/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Registers a client webhook endpoint to receive events from the Pismo Kafka-backed event stream."
        }
      ]
    }
  ],
  "bundled": true
}