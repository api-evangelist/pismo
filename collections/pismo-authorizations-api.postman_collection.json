  "info": {
    "_postman_id": "429708a2-68ea-4648-9753-8b97513cce16",
    "name": "Pismo Accounts Authorizations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Specification of the Pismo cloud-native issuer-processing and core-banking platform API. Covers accounts, customers, cards, authorizations, transactions and statements, programs, and event/webhook configuration. Pismo is a Visa-owned platform (acquired January 2024). Authentication uses OAuth2 client-credentials to obtain a Bearer access token; account-scoped endpoints additionally require an account-specific token that encodes a Pismo account ID.\n\nContact Support:\n Name: Pismo Developer Support",
      "type": "text/plain"
    }
  }
